# @vercel/analytics@2 declares an optional peer on vue-router@^4, but this app
# runs vue-router@5. The conflict is cosmetic — we use the framework-agnostic
# `inject()` entry (see src/main.ts), which never touches vue-router — but it is
# fatal to `npm ci`, which both GitHub Actions and Vercel run to build.
legacy-peer-deps=true
